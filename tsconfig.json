{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/main.tsx",
    "src/entry-server.tsx",
    "src/app/App.tsx",
    "src/app/site/**/*.tsx",
    "src/app/components/Intercom.tsx"
  ]
}
